#!/usr/bin/env python3
"""commit-msg gate for robo-bump-truck-build (tracked; activate per clone with an ABSOLUTE path:
git config core.hooksPath <clone>/scripts/hooks). Reads the message file exactly as git wrote it - comment
lines, template and all - and refuses a co-author trailer, opaque content or any denylist hit.
Hits are reported by denylist line number, never by the string."""
import pathlib, sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
import gate_lib


def fail(msg):
    print("commit-msg: REFUSED — " + msg, file=sys.stderr)
    sys.exit(1)


try:
    if len(sys.argv) < 2:
        fail("no message file given.")
    raw = pathlib.Path(sys.argv[1]).read_bytes()
    try:
        deny = gate_lib.load_denylist()
    except gate_lib.GateError as exc:
        fail(str(exc))
    probs = gate_lib.message_problems(raw, deny)
    if probs:
        for p in probs:
            print("commit-msg: REFUSED — " + p, file=sys.stderr)
        sys.exit(1)
except SystemExit:
    raise
except Exception as exc:
    fail("check could not complete: " + repr(exc))
